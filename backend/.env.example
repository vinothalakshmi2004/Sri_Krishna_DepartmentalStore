# ---------------------------------------------------------------
# GreenMart backend configuration
# Copy this file to ".env" and adjust the values.
# ---------------------------------------------------------------

# Port the API + Socket.io server listens on
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/greenmart_test

# JWT settings for admin login (use a long random secret in real use)
JWT_SECRET=test_jwt_secret_change_me_123
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS + Socket.io.
# Several origins can be given comma-separated, e.g.
# CLIENT_URL=http://localhost:5173,http://192.168.1.20:5173
CLIENT_URL=http://localhost:5173

# Default admin created on first start (only if no admin exists yet).
# Change the password from the admin panel after the first login.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# development shows stack traces for server errors; use production for live use
NODE_ENV=development

# ---- Optional (defaults shown) ----
# MAX_UPLOAD_MB=5            # max size of one uploaded image
# ORDER_RATE_LIMIT=10        # max orders per IP per 15 minutes
# TRUST_PROXY=1              # proxies in front of the app (default 1 when NODE_ENV=production, else 0)
