{
  "name": "greenmart-backend",
  "version": "1.0.0",
  "description": "GreenMart departmental store ordering system - REST API + Socket.io backend",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seed.js",
    "restore": "node utils/restoreBackup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "ext": "js,json",
    "ignore": [
      "uploads/*",
      "node_modules/*"
    ]
  },
  "keywords": [
    "greenmart",
    "grocery",
    "ordering",
    "express",
    "mongodb",
    "socket.io"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@json2csv/plainjs": "^7.0.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
